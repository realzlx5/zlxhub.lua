-- ===== SERVICES =====
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- ===== KEYS.TXT RAW LINK =====
local KEYS_URL = "https://raw.githubusercontent.com/realzlx5/keys.txt/main/keys.txt"

-- ===== KEY CHECK =====
local userKey = getgenv().script_key
if not userKey then
    player:Kick("❌ No Key")
    return
end

local ok, keysData = pcall(function()
    return game:HttpGet(KEYS_URL)
end)

if not ok then
    player:Kick("❌ Could not load keys")
    return
end

local valid = false
for k in string.gmatch(keysData, "[^\r\n]+") do
    if k == userKey then
        valid = true
        break
    end
end

if not valid then
    player:Kick("❌ Wrong Key")
    return
end

-- ===== CHARACTER =====
local function getHumanoid()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("Humanoid"), char
end

local humanoid, character = getHumanoid()
player.CharacterAdded:Connect(function()
    humanoid, character = getHumanoid()
end)

